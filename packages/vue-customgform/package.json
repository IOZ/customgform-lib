{
  "name": "@customgform-lib/vue-customgform",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/vue-customgform.umd.cjs",
  "module": "dist/vue-customgform.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-customgform.js",
      "require": "./dist/vue-customgform.umd.cjs",
      "default": "./dist/vue-customgform.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "lint": "oxlint -c ../../oxlint.config.mjs src",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@customgform-lib/customgform-core": "^1.2.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
