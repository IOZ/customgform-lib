{
  "name": "customgform",
  "version": "1.0.0",
  "private": true,
  "description": "CustomGForm",
  "main": "index.js",
  "namespace": "@customgform",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "./packages/customgform-core",
    "./packages/react-customgform"
  ],
  "scripts": {
    "build": "npm run build -w @customgform-lib/customgform-core && npm run build -w @customgform-lib/react-customgform",
    "changeset": "changeset",
    "release:publish": "changeset publish",
    "test": "npm run build",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOZ/customgform-lib.git"
  },
  "keywords": [
    "CustomGform",
    "Google",
    "Form",
    "Form"
  ],
  "author": "customgform",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IOZ/customgform-lib/issues"
  },
  "homepage": "https://github.com/IOZ/customgform-lib#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
