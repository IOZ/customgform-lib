    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOZ/customgform-lib.git",
    "directory": "packages/vue-customgform"
  },
  "bugs": {
    "url": "https://github.com/IOZ/customgform-lib/issues"
  },
  "homepage": "https://github.com/IOZ/customgform-lib/tree/master/packages/vue-customgform",
  "keywords": [
    "google-form",
    "forms",
    "form-customizer",
    "vue"
  ],
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue": "^3.5.43"
  }
